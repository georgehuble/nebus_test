# Example environment for the async payment processing service.
# Copy to `.env` and replace the placeholder values. Never commit real secrets.

# --- Required ---------------------------------------------------------------
API_KEY=replace-me-with-your-own-api-key
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- Processing tuning (optional) ------------------------------------------
MAX_ATTEMPTS=3
MAX_RECOVERIES=5
RETRY_BASE_DELAY_SECONDS=1.0
GATEWAY_MIN_DELAY_SECONDS=2.0
GATEWAY_MAX_DELAY_SECONDS=5.0
GATEWAY_DECLINE_PROBABILITY=0.10

# --- Leases and heartbeats (optional) --------------------------------------
ATTEMPT_LEASE_SECONDS=15.0
HEARTBEAT_INTERVAL_SECONDS=3.0
RELAY_CLAIM_LEASE_SECONDS=60.0

# --- Background loops (optional) -------------------------------------------
RELAY_BATCH_SIZE=50
RELAY_POLL_INTERVAL_SECONDS=1.0
RETRY_POLL_INTERVAL_SECONDS=0.5

# --- Network (optional) -----------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=10.0

# --- Observability (optional) ----------------------------------------------
LOG_LEVEL=INFO
SERVICE_NAME=payment-service
